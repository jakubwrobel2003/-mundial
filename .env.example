# ============================================================
# MUNDIAL 2026 – Szablon konfiguracji (.env.example)
# Skopiuj do .env i uzupełnij prawdziwymi kluczami.
# Ten plik MOŻNA commitować – nie zawiera sekretów.
# ============================================================

FOOTBALL_DATA_API_KEY=your_football_data_key_here
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_RATE_LIMIT_PER_MINUTE=10
FOOTBALL_DATA_CACHE_SECONDS=120

TAVILY_API_KEY=tvly-your_key_here
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2000
CLAUDE_TEMPERATURE=0.3

DATABASE_PATH=./mundial2026.db

RAG_TOP_K=5
RAG_MIN_RANK=-50.0

ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
ANGULAR_PORT=4200
